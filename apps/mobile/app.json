{
  "expo": {
    "name": "Lana Health",
    "slug": "acitypass",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "acitypass",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/9536944f-7807-4389-add0-706446f3ae81"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.activecitypass.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Lana Health needs access to your photo library so you can upload a profile picture and choose meal photos to help log what you ate.",
        "NSCameraUsageDescription": "Lana Health uses your camera to take a profile photo and to photograph meals so you can log what you ate.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "acitypass"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.663151808102-g5rqmh13tqai4vujnlkttk26dalmgbsr"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.activecitypass.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "com.googleusercontent.apps.663151808102-87vm95r2fa0rk84os1qimav5mku7ah2a" }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lana-wordmark.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Lana Health reads your steps, active and resting energy, heart rate, workouts, and body measurements (weight, height, body fat, waist) from Apple Health to show them in your Analytics page.",
          "NSHealthUpdateUsageDescription": "Lana Health does not write data to Apple Health.",
          "background": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lana Health lets you choose a meal photo to help log what you ate. The photo is analysed once and not stored.",
          "cameraPermission": "Lana Health lets you photograph a meal to help log what you ate. The photo is analysed once and not stored."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Lana Health uses your location to show bookable gyms, classes, trainers and experiences available near you. Your workouts, nutrition and progress work without it.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "acp-vz"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9536944f-7807-4389-add0-706446f3ae81"
      }
    },
    "owner": "acitypass"
  }
}
